# ── atproto-foodwiki web app ──────────────────────────────────────────
# OAuth redirect + environment for Phase 3/4 (the garden web app).

# Public URL of the web app (Railway service or exe.dev preview)
#APP_URL=https://garden.up.railway.app
#APP_URL=http://localhost:5173

# HappyView instance (Phase 2)
#HAPPYVIEW_URL=https://happyview.up.railway.app   # full URL incl. scheme; no trailing slash
#HAPPYVIEW_ADMIN_TOKEN=hv_xxx

# atproto OAuth client (Phase 3)
#OAUTH_CLIENT_ID=http://localhost?redirect_uri=http://127.0.0.1:5173/oauth/callback&scope=atproto
#OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
